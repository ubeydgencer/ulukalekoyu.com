---
import Base from '../../../../layouts/Base.astro';
import SozlukLetter from '../../../../components/SozlukLetter.astro';
import { LETTERS, letterTitle, letterDesc, letterJsonLd } from '../../../../data/sozluk';
export function getStaticPaths() {
  return LETTERS.map((info) => ({ params: { letter: info.slug }, props: { info } }));
}
const lang = 'en' as const;
const { info } = Astro.props;
---
<Base lang={lang} page="sozluk" subPath={`harf/${info.slug}/`}
  title={letterTitle(lang, info.letter)} description={letterDesc(lang, info.letter, info.count)}
  ogType="website" ogImage={`https://ulukalekoyu.com/og/${lang}/sozluk.png`} jsonld={letterJsonLd(lang, info)}>
  <SozlukLetter lang={lang} info={info} />
</Base>
