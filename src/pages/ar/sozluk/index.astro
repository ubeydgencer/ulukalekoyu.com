---
import Base from '../../../layouts/Base.astro';
import SozlukBody from '../../../components/SozlukBody.astro';
import { SOZLUK_UI } from '../../../data/sozluk';
const lang = 'ar' as const;
const t = SOZLUK_UI[lang];
const jsonld = JSON.stringify({'@context':'https://schema.org','@type':'CollectionPage',name:t.h1,inLanguage:lang,about:{'@type':'Place','@id':'https://ulukalekoyu.com/#place'},mainEntityOfPage:'https://ulukalekoyu.com/ar/sozluk/'});
---
<Base lang={lang} page="sozluk" title={t.metaTitle} description={t.metaDesc} ogType="website" jsonld={jsonld}>
  <SozlukBody lang={lang} />
</Base>
